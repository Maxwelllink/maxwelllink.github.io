def _as_list(value):
    """Convert Python iterables and Java collections/ArrayLists to a Python list.

    Chaquopy does not expose every Java collection as a Python-iterable object;
    in particular, some exteraGram builds return java.util.ArrayList instances
    that raise "'ArrayList' object is not iterable".
    """
    if value is None:
        return []
    try:
        return list(value)
    except (TypeError, AttributeError):
        pass
    # Java List / ArrayList bridge fallback.
    try:
        size = int(value.size())
        return [value.get(i) for i in range(size)]
    except Exception:
        pass
    # Some Java collection wrappers expose toArray() even when iteration fails.
    try:
        return list(value.toArray())
    except Exception:
        return []


def _to_signed(color):
    """Java int is signed; ARGB constants like 0xFFFFFFFF must be converted."""
    color = int(color) & 0xFFFFFFFF
    return color - 0x100000000 if color & 0x80000000 else color


def _theme_color(key_names, default=None):
    """Read a color from the current Telegram theme by the first existing key."""
    try:
        from org.telegram.ui.ActionBar import Theme
        for name in key_names:
            key = getattr(Theme, name, None)
            if key is not None:
                return Theme.getColor(key)
    except Exception as e:
        log("Theme color failed: %r" % (e,))
    return default


def _is_dark_theme():
    try:
        from org.telegram.ui.ActionBar import Theme
        return bool(Theme.isCurrentThemeDark())
    except Exception:
        return True


